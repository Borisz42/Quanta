# ==============================================================================
# QUANTA Environment Variables & Credentials Template
# Copy this file to .env and replace placeholders with your actual tokens.
# ==============================================================================

# Hugging Face Access Token (read/write access for model/dataset fetching & gated models)
HF_TOKEN=your_huggingface_token_here
HUGGING_FACE_HUB_TOKEN=your_huggingface_token_here

# QUANTA Offline Data Directory
QUANTA_DATA_DIR=data

# Unsloth Desktop / Local LLM Transducer Service Endpoint
UNSLOTH_BASE_URL=http://localhost:8888/v1
UNSLOTH_FALLBACK_URL=http://localhost:1234/v1
