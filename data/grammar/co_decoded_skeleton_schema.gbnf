# QUANTA Co-Decoded Fast Skeleton Transducer
# GBNF Grammar for Constrained Decoding of Surface Skeletons with Compact Kev Enums (Flat JSON)

root ::= ws "{" ws "\"entities\"" ws ":" ws entity-list ws "," ws "\"events\"" ws ":" ws event-list ws "}" ws

entity-list ::= "[" ws (entity (ws "," ws entity)*)? ws "]"
entity ::= "{" ws "\"id\"" ws ":" ws string ws "," ws "\"text\"" ws ":" ws string (ws "," ws "\"category\"" ws ":" ws string)? ws "}"

event-list ::= "[" ws (event (ws "," ws event)*)? ws "]"
event ::= "{" ws "\"id\"" ws ":" ws string ws "," ws "\"pred\"" ws ":" ws string (ws "," ws "\"subj\"" ws ":" ws (string | "null"))? (ws "," ws "\"obj\"" ws ":" ws (string | "null"))? (ws "," ws "\"intent\"" ws ":" ws intent-val)? (ws "," ws "\"epist\"" ws ":" ws epist-val)? (ws "," ws "\"allen\"" ws ":" ws allen-val)? (ws "," ws "\"pearl\"" ws ":" ws pearl-val)? ws "}"

intent-val ::= "\"I\"" | "\"D\"" | "\"C\"" | "\"E\""
epist-val ::= "\"O\"" | "\"D\"" | "\"H\"" | "\"C\""
allen-val ::= "\"M\"" | "\"B\"" | "\"O\"" | "\"D\"" | "\"N\""
pearl-val ::= "\"M\"" | "\"C\"" | "\"N\""

string ::= "\"" ([^"\\] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""
ws ::= [ ]?
